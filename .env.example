# --- Choose ONE provider by setting its API key ---
# If both keys are set, OpenAI is used unless LLM_PROVIDER says otherwise.

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (leave blank if using OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: force a provider ("openai" or "anthropic").
# If omitted, it auto-detects from whichever key above is present.
# LLM_PROVIDER=openai

# Optional: override the models.
#   MODEL_LIGHT  -> summarize + keyword (cheaper/faster)
#   MODEL_HEAVY  -> link selection + insertion (stronger reasoning)
# Defaults:  OpenAI -> gpt-4o-mini / gpt-4o     Anthropic -> claude-sonnet-5 / claude-opus-5
# MODEL_LIGHT=gpt-4o-mini
# MODEL_HEAVY=gpt-4o

# Optional: port (default 5055)
PORT=5055
